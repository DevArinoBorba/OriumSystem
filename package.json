{
  "name": "orium-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": { "node": ">=24.19.0 <25" },
  "scripts": {
    "dev": "pnpm build:foundation && pnpm -r --parallel --filter @orium/contracts --filter @orium/api --filter @orium/web dev",
    "build:foundation": "pnpm --filter @orium/contracts build && pnpm --filter @orium/api build",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @orium/contracts build && pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "eslint apps packages tests vitest.config.ts",
    "test": "pnpm --filter @orium/contracts build && node --env-file=.env node_modules/vitest/vitest.mjs run",
    "test:unit": "pnpm --filter @orium/contracts build && vitest run tests/config.test.ts tests/rbac.test.ts",
    "db:migrate": "pnpm build:foundation && node --env-file=.env apps/api/dist/cli.js migrate",
    "db:bootstrap": "pnpm build:foundation && node --env-file=.env apps/api/dist/cli.js bootstrap",
    "db:recover": "pnpm build:foundation && node --env-file=.env apps/api/dist/cli.js recover",
    "db:up": "docker compose up -d postgres postgres-test",
    "db:stop": "docker compose stop postgres postgres-test"
  },
  "devDependencies": {
    "@orium/contracts": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.12.0",
    "fastify": "5.12.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
